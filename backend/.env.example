# ==============================================================================
# MISTY Backend Environment Configuration (Example)
# Copy this file to `backend/.env` for local development.
# ==============================================================================

# Django Core Security & Settings
SECRET_KEY=misty-insecure-dev-secret-key-change-in-production-only-luxury-perfume
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Cross-Origin Resource Sharing (Frontend Dev Origin)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MySQL Database Connection (using mysqlclient driver)
DB_NAME=misty_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_HOST=127.0.0.1
DB_PORT=3306

# Cloudinary Image Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# JWT Token Lifetime Settings
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

